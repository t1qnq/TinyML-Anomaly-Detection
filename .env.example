# Copy this file to .env and fill in local credentials.
# Do not commit .env.

# Wi-Fi used by ESP32-S3 firmware.
WIFI_SSID=
WIFI_PASSWORD=

# HiveMQ Cloud connection used by firmware, Flutter app and optional demo scripts.
# Example host format:
# MQTT_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
# Example TLS port:
# MQTT_PORT=8883
MQTT_HOST=
MQTT_PORT=8883

# MQTT credentials. Fill locally in .env only.
# MQTT_USERNAME=your_hivemq_username
# MQTT_PASSWORD=your_hivemq_password
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topic used by the washing-machine monitor.
MQTT_TOPIC=tinyml/quang_wm_2026/status
